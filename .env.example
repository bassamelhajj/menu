# Copy to .env.local (ignored by git) or add these to your Vercel project.
# Server-only values: never prefix them with VITE_.
# Generate the password hash with: npm run hash -- "long passphrase"
# Generate the session secret with: npm run secret

ADMIN_USERNAME=admin@benova.com
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Optional: client-side menu curtain. Cosmetic only, not a security boundary.
VITE_SITE_PASSWORD_SHA256=
