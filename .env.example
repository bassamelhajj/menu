# Copy to .env.local (ignored by git) or add these to your Vercel project.
# Never put plaintext passwords here — use the SHA-256 output of `npm run hash`.

VITE_ADMIN_USERNAME=owner
VITE_ADMIN_PASSWORD_SHA256=

# Optional: locks the public menu. Leave empty to keep the menu open.
VITE_SITE_PASSWORD_SHA256=
